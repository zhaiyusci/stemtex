+    result = lua_pcall(L, nargs, nresults, errfunc);
+#endif
+    stemtex_recovery.protected_depth--;
+    stemtex_recovery.protected_state = previous;
+    if (stemtex_checkpoint_recovery_pending())
+        stemtex_recovery_abort("StemTeX request aborted");
+    return result;
+}
