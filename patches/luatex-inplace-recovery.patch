+/* Let Lua unwind its protected C frames before restoring the VM heap. Nested
+ * TeX-from-Lua errors propagate to the outermost engine-owned protected call. */
+int stemtex_recovery_pcall(lua_State *L, int nargs, int nresults, int errfunc)
+{
+    lua_State *previous = stemtex_recovery.protected_state;
+    int result;
+    stemtex_recovery.protected_state = L;
+    stemtex_recovery.protected_depth++;
