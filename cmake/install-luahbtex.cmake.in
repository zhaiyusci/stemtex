set(engine_dir "@STEMTEX_LUAHBTEX_DIR@")
set(manifest "${engine_dir}/build-manifest.json")
if(NOT EXISTS "${manifest}")
  message(FATAL_ERROR "Missing ${manifest}. Build LuaHBTeX with scripts/build-luahbtex-mingw.ps1 first.")
endif()
file(READ "${manifest}" manifest_json)

function(check_luahbtex_hash filename field)
  string(JSON expected GET "${manifest_json}" "${field}")
  string(TOLOWER "${expected}" expected)
  file(SHA256 "${engine_dir}/${filename}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${filename} does not match the LuaHBTeX build manifest in ${engine_dir}")
  endif()
endfunction()

check_luahbtex_hash(luahbtex.exe binary_sha256)
check_luahbtex_hash(luahbtex.exe.stemtex-checkpoint checkpoint_ranges_sha256)
set(payload "${engine_dir}/luahbtex.exe" "${engine_dir}/luahbtex.exe.stemtex-checkpoint" "${manifest}")
string(JSON dll_count LENGTH "${manifest_json}" copied_runtime_dlls)
if(dll_count GREATER 0)
  math(EXPR last_dll "${dll_count} - 1")
  foreach(index RANGE ${last_dll})
    string(JSON dll GET "${manifest_json}" copied_runtime_dlls ${index})
    if(NOT EXISTS "${engine_dir}/${dll}")
      message(FATAL_ERROR "Missing LuaHBTeX runtime dependency: ${engine_dir}/${dll}")
    endif()
    list(APPEND payload "${engine_dir}/${dll}")
  endforeach()
endif()
file(INSTALL ${payload} DESTINATION "${CMAKE_INSTALL_PREFIX}/runtime/bin/luatex" TYPE FILE)
